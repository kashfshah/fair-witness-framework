// Styles imported dynamically to avoid render blocking
import '../styles/global.css';

// Component imports
import MobileMenuScript from '../components/global/MobileMenuScript.astro';
import CriticalCSS from '../components/performance/CriticalCSS.astro';
import OptimizedFonts from '../components/performance/OptimizedFonts.astro';
import DeferredScripts from '../components/performance/DeferredScripts.astro';
import SecurityHeaders from '../components/security/SecurityHeaders.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
  modifiedDate?: string;
}

const { 
  title, 
  description = "The Fair Witness Framework for structured, objective LLM interactions",
  image = "/images/fair-witness-og.jpg",
  canonicalUrl = Astro.url.pathname,
  type = "website",
  publishedDate,
  modifiedDate
} = Astro.props;

const siteUrl = "https://fairwitness.bot";
const fullUrl = `${siteUrl}${canonicalUrl}`;
const imageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;
const siteName = "Fair Witness Bot";
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Security Headers -->
    <SecurityHeaders />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    
    <!-- Primary Meta Tags -->
    <title>{title} | Fair Witness Bot</title>
    <meta name="title" content={`${title} | Fair Witness Bot`} />
    <meta name="description" content={description} />
    <meta name="keywords" content="fair witness, function-epistemic framework, LLM interactions, objective AI, structured prompting, E-Prime language, AI framework" />
    <link rel="canonical" href={fullUrl} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:title" content={`${title} | Fair Witness Bot`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content={siteName} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={fullUrl} />
    <meta property="twitter:title" content={`${title} | Fair Witness Bot`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageUrl} />
    
    <!-- Article Specific Metadata -->
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
    
    <!-- Structured Data / JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": type === 'article' ? "Article" : "WebSite",
      "headline": title,
      "description": description,
      "image": imageUrl,
      "url": fullUrl,
      "name": siteName,
      ...publishedDate ? {"datePublished": publishedDate} : {},
      ...modifiedDate ? {"dateModified": modifiedDate} : {},
      "author": {
        "@type": "Organization",
        "name": "Fair Witness Bot"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Fair Witness Bot",
        "logo": {
          "@type": "ImageObject",
          "url": `${siteUrl}/images/logo.png`
        }
      }
    })} />
    
    <!-- Optimized Font Loading Strategy -->
    <OptimizedFonts />
    
    <!-- Critical CSS Inlined -->
    <CriticalCSS />
  </head>
  <body class="antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent1 focus:text-white focus:outline-none focus:rounded">Skip to main content</a>
    
    <header class="border-b border-primary/10 dark:border-secondary/10" role="banner">
      <div class="container py-4 flex justify-between items-center">
        <div class="flex items-center gap-2">
          <a href="/" class="font-display text-2xl font-bold">Fair Witness Bot</a>
        </div>
        
        <!-- Desktop Navigation -->
        <nav class="hidden md:block" aria-label="Main navigation">
          <ul class="flex gap-6" role="list">
            <li><a href="/quick-start" class="hover:text-accent1 font-medium">Quick Start</a></li>
            <li><a href="/framework" class="hover:text-accent1">Framework</a></li>
            <li><a href="/implementation" class="hover:text-accent1">Implementation</a></li>
            <li><a href="/examples" class="hover:text-accent1">Examples</a></li>
            <li><a href="/about" class="hover:text-accent1">About</a></li>
          </ul>
        </nav>
        
        <!-- Mobile Menu Button -->
        <button 
          id="mobile-menu-toggle" 
          class="md:hidden flex flex-col justify-center items-center w-8 h-8 focus:outline-none focus:ring-2 focus:ring-accent1 focus:ring-opacity-50 rounded"
          aria-expanded="false"
          aria-label="Toggle navigation menu"
          aria-controls="mobile-menu"
          data-menu-toggle
        >
          <span class="block w-6 h-0.5 bg-primary dark:bg-secondary mb-1.5 transition-transform mobile-menu-bar"></span>
          <span class="block w-6 h-0.5 bg-primary dark:bg-secondary mb-1.5 transition-opacity mobile-menu-bar"></span>
          <span class="block w-6 h-0.5 bg-primary dark:bg-secondary transition-transform mobile-menu-bar"></span>
        </button>
      </div>
      
      <!-- Mobile Navigation -->
      <div id="mobile-menu" class="md:hidden hidden py-4 border-t border-primary/10 dark:border-secondary/10" aria-hidden="true">
        <div class="container">
          <nav aria-label="Mobile navigation">
            <ul class="flex flex-col gap-4" role="list">
              <li><a href="/quick-start" class="block py-2 hover:text-accent1 font-medium">Quick Start</a></li>
              <li><a href="/framework" class="block py-2 hover:text-accent1">Framework</a></li>
              <li><a href="/implementation" class="block py-2 hover:text-accent1">Implementation</a></li>
              <li><a href="/examples" class="block py-2 hover:text-accent1">Examples</a></li>
              <li><a href="/about" class="block py-2 hover:text-accent1">About</a></li>
            </ul>
          </nav>
        </div>
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="mt-12 py-10 border-t border-primary/10 dark:border-secondary/10 bg-secondary/5 dark:bg-primary/5" role="contentinfo">
      <div class="container">
        <!-- Main Footer Content -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Brand Column -->
          <div>
            <div class="flex flex-col h-full">
              <h2 class="font-display text-2xl font-bold mb-4">Fair Witness Bot</h2>
              <p class="text-primary/70 dark:text-secondary/70 mb-4">
                A framework for structured, objective LLM interactions that enhances knowledge processing through multiple epistemic functions.
              </p>
            </div>
          </div>
          
          <!-- Quick Links Column -->
          <div>
            <h3 class="font-display text-xl font-medium mb-4">Quick Links</h3>
            <nav aria-label="Footer quick links navigation">
              <ul class="space-y-2">
                <li><a href="/" class="text-primary/80 dark:text-secondary/80 hover:text-accent1 dark:hover:text-accent1 transition-colors">Home</a></li>
                <li><a href="/quick-start" class="text-primary/80 dark:text-secondary/80 hover:text-accent1 dark:hover:text-accent1 transition-colors font-medium">Quick Start</a></li>
                <li><a href="/framework" class="text-primary/80 dark:text-secondary/80 hover:text-accent1 dark:hover:text-accent1 transition-colors">Framework</a></li>
                <li><a href="/implementation" class="text-primary/80 dark:text-secondary/80 hover:text-accent1 dark:hover:text-accent1 transition-colors">Implementation</a></li>
              </ul>
            </nav>
          </div>
          
          <!-- Resources Column -->
          <div>
            <h3 class="font-display text-xl font-medium mb-4">Resources</h3>
            <nav aria-label="Footer resources navigation">
              <ul class="space-y-2">
                <li><a href="/examples" class="text-primary/80 dark:text-secondary/80 hover:text-accent1 dark:hover:text-accent1 transition-colors">Examples</a></li>
                <li><a href="/yaml-configuration" class="text-primary/80 dark:text-secondary/80 hover:text-accent1 dark:hover:text-accent1 transition-colors">YAML Configuration</a></li>
                <li><a href="/literary-influences" class="text-primary/80 dark:text-secondary/80 hover:text-accent1 dark:hover:text-accent1 transition-colors">Literary Influences</a></li>
                <li><a href="https://github.com/kashfshah/fair-witness-framework" target="_blank" rel="noopener noreferrer" class="text-primary/80 dark:text-secondary/80 hover:text-accent1 dark:hover:text-accent1 transition-colors">GitHub Repository</a></li>
              </ul>
            </nav>
          </div>
        </div>
        
        <!-- Sub-Footer -->
        <div class="mt-8 pt-6 border-t border-primary/10 dark:border-secondary/10 text-center text-primary/60 dark:text-secondary/60 text-sm">
          <p>&copy; {new Date().getFullYear()} Fair Witness Bot | All rights reserved</p>
        </div>
      </div>
    </footer>
    <MobileMenuScript />
    
    <!-- Jump to Top Button -->
    <button 
      id="jump-to-top" 
      aria-label="Scroll to top of page"
      class="fixed bottom-6 right-6 bg-accent1/90 hover:bg-accent1 text-white w-12 h-12 rounded-full shadow-lg flex items-center justify-center transform translate-y-20 opacity-0 transition-all duration-300 z-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent1"
      tabindex="0"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
      </svg>
    </button>
    
    <!-- Announce screen reader messages -->
    <div id="sr-announcements" class="sr-only" aria-live="polite" aria-atomic="true"></div>
    
    <!-- Mobile menu functionality with high priority -->    
    <MobileMenuScript />
    
    <!-- Deferred non-critical scripts -->    
    <DeferredScripts />
  </body>
</html>
