import '../styles/global.css';
import MobileMenuScript from '../components/global/MobileMenuScript.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
  modifiedDate?: string;
}

const { 
  title, 
  description = "The Fair Witness Framework for structured, objective LLM interactions",
  image = "/images/fair-witness-og.jpg",
  canonicalUrl = Astro.url.pathname,
  type = "website",
  publishedDate,
  modifiedDate
} = Astro.props;

const siteUrl = "https://fairwitness.bot";
const fullUrl = `${siteUrl}${canonicalUrl}`;
const imageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;
const siteName = "Fair Witness Bot";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    
    <!-- Primary Meta Tags -->
    <title>{title} | Fair Witness Bot</title>
    <meta name="title" content={`${title} | Fair Witness Bot`} />
    <meta name="description" content={description} />
    <meta name="keywords" content="fair witness, function-epistemic framework, LLM interactions, objective AI, structured prompting, E-Prime language, AI framework" />
    <link rel="canonical" href={fullUrl} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:title" content={`${title} | Fair Witness Bot`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content={siteName} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={fullUrl} />
    <meta property="twitter:title" content={`${title} | Fair Witness Bot`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageUrl} />
    
    <!-- Article Specific Metadata -->
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
    
    <!-- Structured Data / JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": type === 'article' ? "Article" : "WebSite",
      "headline": title,
      "description": description,
      "image": imageUrl,
      "url": fullUrl,
      "name": siteName,
      ...publishedDate ? {"datePublished": publishedDate} : {},
      ...modifiedDate ? {"dateModified": modifiedDate} : {},
      "author": {
        "@type": "Organization",
        "name": "Fair Witness Bot"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Fair Witness Bot",
        "logo": {
          "@type": "ImageObject",
          "url": `${siteUrl}/images/logo.png`
        }
      }
    })} />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <header class="border-b border-primary/10 dark:border-secondary/10">
      <div class="container py-4 flex justify-between items-center">
        <div class="flex items-center gap-2">
          <a href="/" class="font-display text-2xl font-bold">Fair Witness Bot</a>
        </div>
        
        <!-- Desktop Navigation -->
        <nav class="hidden md:block">
          <ul class="flex gap-6">
            <li><a href="/quick-start" class="hover:text-accent1 font-medium">Quick Start</a></li>
            <li><a href="/framework" class="hover:text-accent1">Framework</a></li>
            <li><a href="/implementation" class="hover:text-accent1">Implementation</a></li>
            <li><a href="/examples" class="hover:text-accent1">Examples</a></li>
            <li><a href="/about" class="hover:text-accent1">About</a></li>
          </ul>
        </nav>
        
        <!-- Mobile Menu Button -->
        <button id="mobile-menu-toggle" class="md:hidden flex flex-col justify-center items-center w-8 h-8">
          <span class="block w-6 h-0.5 bg-primary dark:bg-secondary mb-1.5 transition-transform mobile-menu-bar"></span>
          <span class="block w-6 h-0.5 bg-primary dark:bg-secondary mb-1.5 transition-opacity mobile-menu-bar"></span>
          <span class="block w-6 h-0.5 bg-primary dark:bg-secondary transition-transform mobile-menu-bar"></span>
        </button>
      </div>
      
      <!-- Mobile Navigation -->
      <div id="mobile-menu" class="md:hidden hidden py-4 border-t border-primary/10 dark:border-secondary/10">
        <div class="container">
          <nav>
            <ul class="flex flex-col gap-4">
              <li><a href="/quick-start" class="block py-2 hover:text-accent1 font-medium">Quick Start</a></li>
              <li><a href="/framework" class="block py-2 hover:text-accent1">Framework</a></li>
              <li><a href="/implementation" class="block py-2 hover:text-accent1">Implementation</a></li>
              <li><a href="/examples" class="block py-2 hover:text-accent1">Examples</a></li>
              <li><a href="/about" class="block py-2 hover:text-accent1">About</a></li>
            </ul>
          </nav>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="mt-12 py-12 border-t border-primary/10 dark:border-secondary/10 bg-secondary/5 dark:bg-primary/5">
      <div class="container">
        <!-- Main Footer Content -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <!-- Brand Column -->
          <div class="md:col-span-1">
            <div class="flex flex-col h-full">
              <h2 class="font-display text-2xl font-bold mb-4">Fair Witness Bot</h2>
              <p class="text-primary/70 dark:text-secondary/70 mb-4">
                A framework for structured, objective LLM interactions that enhances knowledge processing through multiple epistemic functions.
              </p>
              <div class="mt-auto pt-4">
                <!-- Social Links with proper aria labels -->
                <div class="flex gap-4">
                  <a href="https://twitter.com/fairwitnessbot" target="_blank" rel="noopener noreferrer" class="text-primary/60 hover:text-accent1 dark:text-secondary/60 dark:hover:text-accent1 transition-colors" aria-label="Twitter">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-twitter" viewBox="0 0 16 16">
                      <path d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"/>
                    </svg>
                  </a>
                  <a href="https://github.com/fairwitnessbot" target="_blank" rel="noopener noreferrer" class="text-primary/60 hover:text-accent1 dark:text-secondary/60 dark:hover:text-accent1 transition-colors" aria-label="GitHub">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-github" viewBox="0 0 16 16">
                      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                    </svg>
                  </a>
                  <a href="https://discord.gg/fairwitnessbot" target="_blank" rel="noopener noreferrer" class="text-primary/60 hover:text-accent1 dark:text-secondary/60 dark:hover:text-accent1 transition-colors" aria-label="Discord">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-discord" viewBox="0 0 16 16">
                      <path d="M13.545 2.907a13.227 13.227 0 0 0-3.257-1.011.05.05 0 0 0-.052.025c-.141.25-.297.577-.406.833a12.19 12.19 0 0 0-3.658 0 8.258 8.258 0 0 0-.412-.833.051.051 0 0 0-.052-.025c-1.125.194-2.22.534-3.257 1.011a.041.041 0 0 0-.021.018C.356 6.024-.213 9.047.066 12.032c.001.014.01.028.021.037a13.276 13.276 0 0 0 3.995 2.02.05.05 0 0 0 .056-.019c.308-.42.582-.863.818-1.329a.05.05 0 0 0-.01-.059.051.051 0 0 0-.018-.011 8.875 8.875 0 0 1-1.248-.595.05.05 0 0 1-.02-.066.051.051 0 0 1 .015-.019c.084-.063.168-.129.248-.195a.05.05 0 0 1 .051-.007c2.619 1.196 5.454 1.196 8.041 0a.052.052 0 0 1 .053.007c.08.066.164.132.248.195a.051.051 0 0 1-.004.085 8.254 8.254 0 0 1-1.249.594.05.05 0 0 0-.03.03.052.052 0 0 0 .003.041c.24.465.515.909.817 1.329a.05.05 0 0 0 .056.019 13.235 13.235 0 0 0 4.001-2.02.049.049 0 0 0 .021-.037c.334-3.451-.559-6.449-2.366-9.106a.034.034 0 0 0-.02-.019Zm-8.198 7.307c-.789 0-1.438-.724-1.438-1.612 0-.889.637-1.613 1.438-1.613.807 0 1.45.73 1.438 1.613 0 .888-.637 1.612-1.438 1.612Zm5.316 0c-.788 0-1.438-.724-1.438-1.612 0-.889.637-1.613 1.438-1.613.807 0 1.451.73 1.438 1.613 0 .888-.631 1.612-1.438 1.612Z"/>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Quick Links Column -->
          <div>
            <h3 class="font-display text-xl font-medium mb-4">Quick Links</h3>
            <nav aria-label="Footer quick links navigation">
              <ul class="space-y-2">
                <li><a href="/" class="text-primary/80 dark:text-secondary/80 hover:text-accent1 dark:hover:text-accent1 transition-colors">Home</a></li>
                <li><a href="/quick-start" class="text-primary/80 dark:text-secondary/80 hover:text-accent1 dark:hover:text-accent1 transition-colors font-medium">Quick Start</a></li>
                <li><a href="/framework" class="text-primary/80 dark:text-secondary/80 hover:text-accent1 dark:hover:text-accent1 transition-colors">Framework</a></li>
                <li><a href="/implementation" class="text-primary/80 dark:text-secondary/80 hover:text-accent1 dark:hover:text-accent1 transition-colors">Implementation</a></li>
              </ul>
            </nav>
          </div>
          
          <!-- Resources Column -->
          <div>
            <h3 class="font-display text-xl font-medium mb-4">Resources</h3>
            <nav aria-label="Footer resources navigation">
              <ul class="space-y-2">
                <li><a href="/examples" class="text-primary/80 dark:text-secondary/80 hover:text-accent1 dark:hover:text-accent1 transition-colors">Examples</a></li>
                <li><a href="/yaml-configuration" class="text-primary/80 dark:text-secondary/80 hover:text-accent1 dark:hover:text-accent1 transition-colors">YAML Configuration</a></li>
                <li><a href="/literary-influences" class="text-primary/80 dark:text-secondary/80 hover:text-accent1 dark:hover:text-accent1 transition-colors">Literary Influences</a></li>
                <li><a href="https://github.com/fairwitnessbot/framework" target="_blank" rel="noopener noreferrer" class="text-primary/80 dark:text-secondary/80 hover:text-accent1 dark:hover:text-accent1 transition-colors">GitHub Repository</a></li>
              </ul>
            </nav>
          </div>
          
          <!-- Newsletter Signup Column -->
          <div>
            <h3 class="font-display text-xl font-medium mb-4">Stay Updated</h3>
            <p class="text-primary/70 dark:text-secondary/70 mb-4">Receive updates and insights about the Function-Epistemic Framework.</p>
            <form class="space-y-2" aria-label="Newsletter signup">
              <div>
                <label for="footer-email" class="sr-only">Email address</label>
                <input type="email" id="footer-email" name="email" placeholder="Your email address" required class="w-full px-4 py-2 rounded bg-white dark:bg-primary/20 border border-primary/20 dark:border-secondary/20 focus:outline-none focus:ring-2 focus:ring-accent1" />
              </div>
              <button type="submit" class="w-full bg-accent1 hover:bg-accent1/80 text-white py-2 px-4 rounded transition-colors">Subscribe</button>
            </form>
          </div>
        </div>
        
        <!-- Sub-Footer -->
        <div class="mt-12 pt-8 border-t border-primary/10 dark:border-secondary/10 flex flex-col md:flex-row justify-between items-center text-primary/60 dark:text-secondary/60 text-sm">
          <p>&copy; {new Date().getFullYear()} Fair Witness Bot. All rights reserved.</p>
          <div class="flex gap-6 mt-4 md:mt-0">
            <a href="/privacy" class="hover:text-accent1 transition-colors">Privacy Policy</a>
            <a href="/terms" class="hover:text-accent1 transition-colors">Terms of Use</a>
            <a href="/contact" class="hover:text-accent1 transition-colors">Contact</a>
          </div>
        </div>
      </div>
    </footer>
    <MobileMenuScript />
  </body>
</html>
