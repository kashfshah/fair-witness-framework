---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Quick Start Guide">
  <section class="py-16 bg-gradient-to-b from-secondary to-white dark:from-primary dark:to-primary/80">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h1 class="text-4xl font-display font-bold mb-6">Quick Start Guide</h1>
        <p class="text-xl mb-4 text-primary/80 dark:text-secondary/80">
          Get started with the Fair Witness Framework in minutes
        </p>
      </div>
    </div>
  </section>
  
  <section class="py-12">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <div class="prose prose-lg dark:prose-invert mb-8">
          <p>
            This quick start guide provides the essential steps to implement the Fair Witness Framework in your LLM applications. The framework functions with any LLM that accepts system prompts or configuration instructions.
          </p>
        </div>
        
        <div class="card mb-8">
          <h2 class="text-2xl font-display font-bold mb-6">Step 1: Copy the Base Configuration</h2>
          
          <div class="bg-white dark:bg-primary/50 p-4 rounded-lg mb-4">
            <pre class="text-sm overflow-x-auto"><code class="language-yaml">emulation:
  type: Fair Witness Bot
  framework: Function-Epistemic Hybrid Framework
  epistemic_functions:
    - observer
    - evaluator
    - analyst
    - synthesist
    - communicator
  constraints:
    natural_language:
      style: E-Prime
  output:
    type: natural language
    detail_level: range(moderate,high)
    length: range(moderate, high)
    complexity: range(low, high)
    style: dry</code></pre>
          </div>
          
          <div class="flex justify-end">
            <button class="btn btn-secondary">Copy to Clipboard</button>
          </div>
        </div>
        
        <div class="card mb-8">
          <h2 class="text-2xl font-display font-bold mb-6">Step 2: Choose Your LLM Platform</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <a href="#openai" class="p-4 bg-white dark:bg-primary/40 rounded border border-primary/10 dark:border-secondary/10 hover:border-accent1 dark:hover:border-accent1 transition-colors">
              <h3 class="font-display font-medium mb-2">OpenAI</h3>
              <p class="text-sm text-primary/70 dark:text-secondary/70">ChatGPT / GPT-4</p>
            </a>
            
            <a href="#anthropic" class="p-4 bg-white dark:bg-primary/40 rounded border border-primary/10 dark:border-secondary/10 hover:border-accent1 dark:hover:border-accent1 transition-colors">
              <h3 class="font-display font-medium mb-2">Anthropic</h3>
              <p class="text-sm text-primary/70 dark:text-secondary/70">Claude Models</p>
            </a>
            
            <a href="#langchain" class="p-4 bg-white dark:bg-primary/40 rounded border border-primary/10 dark:border-secondary/10 hover:border-accent1 dark:hover:border-accent1 transition-colors">
              <h3 class="font-display font-medium mb-2">LangChain</h3>
              <p class="text-sm text-primary/70 dark:text-secondary/70">Framework Integration</p>
            </a>
          </div>
        </div>
        
        <div id="openai" class="card mb-8">
          <h2 class="text-2xl font-display font-bold mb-6">OpenAI Implementation</h2>
          
          <div class="prose prose-lg dark:prose-invert mb-4">
            <p>This implementation works with GPT-3.5, GPT-4, and other OpenAI chat models.</p>
          </div>
          
          <div class="bg-white dark:bg-primary/50 p-4 rounded-lg mb-4">
            <pre class="text-sm overflow-x-auto"><code class="language-javascript">import OpenAI from 'openai';
import yaml from 'js-yaml';

// Your Fair Witness configuration
const fairWitnessConfig = `
emulation:
  type: Fair Witness Bot
  framework: Function-Epistemic Hybrid Framework
  epistemic_functions:
    - observer
    - evaluator
    - analyst
    - synthesist
    - communicator
  constraints:
    natural_language:
      style: E-Prime
  output:
    type: natural language
    detail_level: range(moderate,high)
    length: range(moderate, high)
    complexity: range(low, high)
    style: dry
`;

const openai = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY,
});

async function fairWitnessQuery(prompt) {
  const systemPrompt = `You are a Fair Witness Bot operating 
under the following configuration:
${fairWitnessConfig}

Follow these constraints strictly when answering.`;

  const response = await openai.chat.completions.create({
    model: "gpt-4",
    messages: [
      { role: "system", content: systemPrompt },
      { role: "user", content: prompt }
    ],
    temperature: 0.7,
  });

  return response.choices[0].message.content;
}

// Example usage
const response = await fairWitnessQuery(
  "Explain the implications of quantum computing for cryptography."
);
console.log(response);</code></pre>
          </div>
          
          <div class="flex justify-end">
            <button class="btn btn-secondary">Copy to Clipboard</button>
          </div>
        </div>
        
        <div id="anthropic" class="card mb-8">
          <h2 class="text-2xl font-display font-bold mb-6">Anthropic Claude Implementation</h2>
          
          <div class="prose prose-lg dark:prose-invert mb-4">
            <p>This implementation works with Claude models from Anthropic.</p>
          </div>
          
          <div class="bg-white dark:bg-primary/50 p-4 rounded-lg mb-4">
            <pre class="text-sm overflow-x-auto"><code class="language-javascript">import Anthropic from '@anthropic-ai/sdk';
import yaml from 'js-yaml';

// Your Fair Witness configuration
const fairWitnessConfig = `
emulation:
  type: Fair Witness Bot
  framework: Function-Epistemic Hybrid Framework
  epistemic_functions:
    - observer
    - evaluator
    - analyst
    - synthesist
    - communicator
  constraints:
    natural_language:
      style: E-Prime
  output:
    type: natural language
    detail_level: range(moderate,high)
    length: range(moderate, high)
    complexity: range(low, high)
    style: dry
`;

const anthropic = new Anthropic({
  apiKey: process.env.ANTHROPIC_API_KEY,
});

async function fairWitnessQuery(prompt) {
  const systemPrompt = `You are a Fair Witness Bot operating 
under the following configuration:
${fairWitnessConfig}

Follow these constraints strictly when answering.`;

  const response = await anthropic.messages.create({
    model: "claude-3-opus-20240229",
    system: systemPrompt,
    messages: [
      {
        role: "user",
        content: prompt
      }
    ],
    max_tokens: 1000,
  });

  return response.content[0].text;
}

// Example usage
const response = await fairWitnessQuery(
  "What factors contribute to software project success?"
);
console.log(response);</code></pre>
          </div>
          
          <div class="flex justify-end">
            <button class="btn btn-secondary">Copy to Clipboard</button>
          </div>
        </div>
        
        <div id="langchain" class="card mb-8">
          <h2 class="text-2xl font-display font-bold mb-6">LangChain Integration</h2>
          
          <div class="prose prose-lg dark:prose-invert mb-4">
            <p>This implementation integrates with the LangChain framework for flexibility across LLM providers.</p>
          </div>
          
          <div class="bg-white dark:bg-primary/50 p-4 rounded-lg mb-4">
            <pre class="text-sm overflow-x-auto"><code class="language-javascript">import { ChatOpenAI } from "langchain/chat_models/openai";
import { 
  ChatPromptTemplate, 
  SystemMessagePromptTemplate, 
  HumanMessagePromptTemplate 
} from "langchain/prompts";
import yaml from 'js-yaml';

// Your Fair Witness configuration
const fairWitnessConfig = `
emulation:
  type: Fair Witness Bot
  framework: Function-Epistemic Hybrid Framework
  epistemic_functions:
    - observer
    - evaluator
    - analyst
    - synthesist
    - communicator
  constraints:
    natural_language:
      style: E-Prime
  output:
    type: natural language
    detail_level: range(moderate,high)
    length: range(moderate, high)
    complexity: range(low, high)
    style: dry
`;

// Create system prompt with configuration
const systemTemplate = `You are a Fair Witness Bot operating 
under the following configuration:
${fairWitnessConfig}

Follow these constraints strictly when answering.`;

const chatPrompt = ChatPromptTemplate.fromPromptMessages([
  SystemMessagePromptTemplate.fromTemplate(systemTemplate),
  HumanMessagePromptTemplate.fromTemplate("{input}")
]);

const model = new ChatOpenAI({ temperature: 0.7 });

async function fairWitnessQuery(prompt) {
  const chain = chatPrompt.pipe(model);
  const response = await chain.invoke({
    input: prompt
  });
  return response.content;
}

// Example usage
const response = await fairWitnessQuery(
  "How can organizations effectively manage technical debt?"
);
console.log(response);</code></pre>
          </div>
          
          <div class="flex justify-end">
            <button class="btn btn-secondary">Copy to Clipboard</button>
          </div>
        </div>
        
        <div class="card">
          <h2 class="text-2xl font-display font-bold mb-6">Step 3: Customize Your Configuration</h2>
          
          <div class="prose prose-lg dark:prose-invert mb-6">
            <p>
              You can customize the Fair Witness configuration to match your specific use case:
            </p>
            
            <ul>
              <li><strong>Epistemic Functions</strong> - Select which functions you need (minimum: observer and communicator)</li>
              <li><strong>Output Parameters</strong> - Adjust detail level, length, complexity, and style</li>
              <li><strong>Additional Constraints</strong> - Add domain-specific knowledge taxonomies or code generation parameters</li>
            </ul>
            
            <p>
              Visit the <a href="/yaml-configuration">YAML Configuration Guide</a> for complete parameter documentation.
            </p>
          </div>
          
          <div class="bg-white dark:bg-primary/50 p-4 rounded-lg mb-4">
            <pre class="text-sm overflow-x-auto"><code class="language-yaml"># Example: Technical documentation focused configuration
emulation:
  type: Fair Witness Bot
  framework: Function-Epistemic Hybrid Framework
  # Focus on observation and communication for technical documentation
  epistemic_functions:
    - observer
    - communicator
  constraints:
    # Add code generation constraints
    code_generation:
      principles: SOLID
      practices: Clean Code
      patterns: Pragmatic
    natural_language:
      style: E-Prime
  output:
    type: natural language
    # More detailed, focused on technical precision
    detail_level: high
    length: moderate
    complexity: moderate
    style: dry</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <section class="py-12 bg-secondary/30 dark:bg-primary/30">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-display font-bold mb-6">Need More Help?</h2>
        <p class="text-xl mb-8 text-primary/80 dark:text-secondary/80">
          Explore our detailed guides or contribute to the project
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/implementation" class="btn btn-primary">Full Implementation Guide</a>
          <a href="https://github.com/yourusername/fairwitnessbot" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">GitHub Repository</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
