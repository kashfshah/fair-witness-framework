import ExampleBox from '../content/ExampleBox.astro';
---

<section class="py-8">
  <div class="container">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-display font-bold mb-6">Try It In Practice</h2>
      
      <p class="mb-6">
        These examples demonstrate progressive application of the Function-Epistemic Framework in practical scenarios. 
        Start with the simpler examples and progress to more complex implementations as you become familiar with the approach.
      </p>
      
      <!-- Basic example for beginners -->
      <ExampleBox
        title="Quick Example"
        level="beginner"
        icon="quickExample"
        prompt="Serve as a comparative analyst, tell me a joke."
        instruction="Copy configuration and append:"
      />
      
      <!-- Observer function example -->
      <ExampleBox
        title="Observer Function Example"
        level="intermediate"
        primaryFunction="observer"
        prompt={`Observe and report the factual information presented in this paragraph:

'Global temperatures increased 1.1°C above pre-industrial levels according to the IPCC Sixth Assessment Report. The report attributes this trend to human activities with >95% confidence. Some regions experienced warming exceeding 2.0°C during this same period.'`}
        instruction="Try with your configuration:"
      />
      
      <!-- Advanced technical example -->
      <ExampleBox
        title="Technical Documentation Example"
        level="advanced"
        primaryFunction="analyst"
        config={`epistemic_functions: ["observer", "analyst", "communicator"]
output: {detail_level: high, style: dry}`}
        prompt={`Analyze this code snippet for potential issues:

function processData(data) {
  let results = [];
  for (let i = 0; i < data.length; i++) {
    if (data[i].value > 0) {
      results.push(data[i]);
    }
  }
  return results;
}`}
        instruction="Implementation example:"
      />
    </div>
  </div>
</section>
