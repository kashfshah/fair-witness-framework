/**
 * MobileMenuScript Component
 * 
 * Provides interactive functionality for mobile menu toggle
 * Follows a clean, functional approach without relying on complex dependencies
 */
---

<script is:inline>
  // Execute immediately to ensure mobile menu functionality
  (function() {
    // Get elements with defensive coding
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuBars = document.querySelectorAll('.mobile-menu-bar');
    const srAnnouncer = document.getElementById('sr-announcements');
    
    // Debug logging to help troubleshoot mobile issues
    console.log('Mobile menu initialized:', {
      toggleExists: !!mobileMenuToggle,
      menuExists: !!mobileMenu,
      menuBarsCount: menuBars.length
    });
    
    if (mobileMenuToggle && mobileMenu) {
      let menuOpen = false;
      
      const toggleMenu = () => {
        menuOpen = !menuOpen;
        
        // Toggle menu visibility - use a more direct approach for reliability
        if (menuOpen) {
          mobileMenu.classList.remove('hidden');
          mobileMenu.style.display = 'block';
        } else {
          mobileMenu.classList.add('hidden');
          mobileMenu.style.display = 'none';
        }
        
        // Ensure body scroll behavior is managed appropriately
        document.body.style.overflow = menuOpen ? 'hidden' : '';
        
        // Update ARIA attributes for accessibility
        mobileMenuToggle.setAttribute('aria-expanded', menuOpen.toString());
        mobileMenu.setAttribute('aria-hidden', (!menuOpen).toString());
        
        // Announce menu state to screen readers
        if (srAnnouncer) {
          srAnnouncer.textContent = menuOpen ? 'Navigation menu opened' : 'Navigation menu closed';
        }
        
        // If menu opens, focus on first menu item for keyboard navigation
        if (menuOpen) {
          setTimeout(() => {
            const firstMenuItem = mobileMenu.querySelector('a');
            if (firstMenuItem) {
              firstMenuItem.focus();
            }
          }, 100);
        }
        
        // Animate hamburger to X
        if (menuOpen) {
          menuBars[0].style.transform = 'translateY(8px) rotate(45deg)';
          menuBars[1].style.opacity = '0';
          menuBars[2].style.transform = 'translateY(-8px) rotate(-45deg)';
        } else {
          menuBars[0].style.transform = 'none';
          menuBars[1].style.opacity = '1';
          menuBars[2].style.transform = 'none';
        }
      };
      
      mobileMenuToggle.addEventListener('click', toggleMenu);
      
      // Close menu when clicking outside
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (menuOpen && 
            !mobileMenu.contains(target) && 
            !mobileMenuToggle.contains(target)) {
          toggleMenu();
        }
      });
      
      // Close menu when window resizes to desktop size
      window.addEventListener('resize', () => {
        if (menuOpen && window.innerWidth >= 768) {
          toggleMenu();
        }
      });
      
      // Support keyboard navigation - allow ESC key to close menu
      document.addEventListener('keydown', (e) => {
        if (menuOpen && e.key === 'Escape') {
          toggleMenu();
          // Return focus to the toggle button when closing with ESC
          mobileMenuToggle.focus();
        }
      });
      
      // Trap focus within menu when open for keyboard accessibility
      mobileMenu.addEventListener('keydown', function(e) {
        if (!menuOpen) return;
        
        const focusableElements = mobileMenu.querySelectorAll('a, button, input, select, textarea, [tabindex]:not([tabindex="-1"])');
        const firstElement = focusableElements[0];
        const lastElement = focusableElements[focusableElements.length - 1];
        
        // Handle tab key to trap focus within the menu
        if (e.key === 'Tab') {
          if (e.shiftKey && document.activeElement === firstElement) {
            e.preventDefault();
            lastElement.focus();
          } else if (!e.shiftKey && document.activeElement === lastElement) {
            e.preventDefault();
            firstElement.focus();
          }
        }
      });
    }
  })();
</script>
